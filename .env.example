# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only (Server Actions, Route Handlers, Edge Functions). Never expose to the client.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=
# Public home page: Tasyir's WhatsApp number, international digits only (e.g. 2126XXXXXXXX).
# Empty → the WhatsApp buttons are hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Local testing only (optional): test director of the "École Test A" fixture.
TEST_DIRECTOR_EMAIL=
TEST_DIRECTOR_PASSWORD=
# Local testing only (optional): director + surveillant of the "École Test B" fixture.
TEST_DIRECTOR_B_EMAIL=
TEST_DIRECTOR_B_PASSWORD=
TEST_STAFF_B_EMAIL=
TEST_STAFF_B_PASSWORD=
# Demo school (scripts/prod/seed-demo-school.mjs): the shared password of directeur@ / prof@ /
# parent@demo.tasyir.ma. Same name in .env.prod.local for production. Never printed by the script.
DEMO_PASSWORD=

# Web push (Phase 10): generate once with `npx web-push generate-vapid-keys`.
# Public key is read by the browser; the private key stays on the server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
